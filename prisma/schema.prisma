// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  clients   Client[]
  leads     Lead[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   // OWNER, MANAGER, MEMBER
  botName   String?  // Custom chatbot assistant name
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Client {
  id            String         @id @default(uuid())
  name          String
  status        String         // HEALTHY, WATCH, AT_RISK
  healthScore   Int            // 0-100
  email         String
  phone         String
  agencyId      String
  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projects      Project[]
  brandMemory   BrandMemory?
  conversations Conversation[]
  approvals     Approval[]
  invoices      Invoice[]
  meetings      Meeting[]
  automationFlows AutomationFlow[]
  emailCampaigns  EmailCampaign[]
  createdAt     DateTime       @default(now())
}

model Lead {
  id            String   @id @default(uuid())
  name          String
  contactName   String
  email         String
  phone         String
  status        String   // LEAD, QUALIFIED, PROPOSAL_SENT, WON, LOST
  value         Float
  proposalText  String?
  aiDraftReady  Boolean  @default(false)
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Project {
  id        String   @id @default(uuid())
  name      String
  status    String   // BACKLOG, IN_PROGRESS, CLIENT_REVIEW, DONE
  budget    Float
  spent     Float    @default(0)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(uuid())
  title       String
  status      String    // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String    // LOW, MEDIUM, HIGH
  dueDate     DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model Approval {
  id         String   @id @default(uuid())
  title      String
  type       String   // IMAGE, VIDEO, TEXT, LINK
  contentUrl String?
  textBody   String?
  status     String   // PENDING, APPROVED, CHANGES_REQUESTED
  feedback   String?
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  channel   String    // WHATSAPP, EMAIL, CHAT
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages  Message[]
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  content        String
  sender         String       // CLIENT, AGENCY_USER, AI
  senderName     String
  isAI           Boolean      @default(false)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model BrandMemory {
  id                String  @id @default(uuid())
  toneOfVoice       String
  bannedWords       String
  colors            String
  logoUrl           String?
  guidelines        String
  industry          String  @default("Services")
  targetAudience    String  @default("General Public")
  marketingPlan     String?
  socialCalendar    String?
  telegramToken     String?
  telegramChatId    String?
  slackWebhookUrl   String?
  discordWebhookUrl String?
  customWebhookUrl  String?
  xConsumerKey      String?
  xConsumerSecret   String?
  xAccessToken      String?
  xAccessTokenSecret String?
  linkedinAccessToken String?
  linkedinPersonId    String?
  clientId          String  @unique
  client            Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String
  amount        Float
  status        String   // PAID, SENT, OVERDUE
  dueDate       DateTime
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Meeting {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  time      String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AutomationFlow {
  id            String   @id @default(uuid())
  name          String
  triggerType   String   // FORM, WEBHOOK
  formFields    String   // JSON string of fields: Array<{name: string, label: string, type: string}>
  actions       String   // JSON string of actions: Array<{type: string, config: any}>
  isActive      Boolean  @default(true)
  webhookPath   String   @unique // Unique path to trigger this flow (e.g. flow-[uuid])
  createdAt     DateTime @default(now())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  logs          AutomationLog[]
}

model AutomationLog {
  id             String   @id @default(uuid())
  flowId         String
  flow           AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  payload        String   // JSON string of request body
  status         String   // SUCCESS, FAILED
  details        String   // log details / error message
  createdAt      DateTime @default(now())
}

model EmailCampaign {
  id           String         @id @default(uuid())
  name         String
  subject      String
  fromName     String
  replyTo      String?
  htmlBody     String
  resendApiKey String?        // Resend API key (optional; can be global env)
  fromAddress  String
  status       String         @default("DRAFT") // DRAFT, SENDING, SENT, FAILED
  sentAt       DateTime?
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts     EmailContact[]
  createdAt    DateTime       @default(now())
}

model EmailContact {
  id         String        @id @default(uuid())
  name       String
  email      String
  status     String        @default("PENDING") // PENDING, SENT, FAILED, BOUNCED
  sentAt     DateTime?
  errorMsg   String?
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
}
